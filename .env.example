# ─── PostgreSQL ───────────────────────────────────────────────
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=cambia_esta_password_segura

# ─── n8n ──────────────────────────────────────────────────────
# Modo SSL  → N8N_PROTOCOL=https  y  WEBHOOK_URL=https://...
# Modo HTTP → N8N_PROTOCOL=http   y  WEBHOOK_URL=http://...
N8N_HOST=solvex.site:5678
N8N_PROTOCOL=https
WEBHOOK_URL=https://solvex.site:5678/

# Clave de cifrado para credenciales guardadas en n8n
# Genera una con: openssl rand -hex 32
N8N_ENCRYPTION_KEY=cambia_por_clave_generada_con_openssl

# Zona horaria
GENERIC_TIMEZONE=America/Bogota

# Nivel de log: error | warn | info | verbose | debug
N8N_LOG_LEVEL=info

# Modo de ejecuciones: regular | queue
EXECUTIONS_MODE=regular

# ─── Qdrant ───────────────────────────────────────────────────
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
# API key opcional — si se deja vacío, Qdrant corre sin autenticación
QDRANT_API_KEY=

# ─── SSL (solo necesario con 'make ssl') ──────────────────────
SSL_CERT_FILE_HOST=/etc/letsencrypt/archive/solvex.site/fullchain1.pem
SSL_KEY_FILE_HOST=/etc/letsencrypt/archive/solvex.site/privkey1.pem

# ─── LLM (descomentar el que uses) ───────────────────────────
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
